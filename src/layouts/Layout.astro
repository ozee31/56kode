---
import { LOCALE, SITE } from "@config";
import { Font } from "astro:assets";
import "@styles/base.css";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

/**
 * Type schema.org de la page. `BlogPosting` est réservé aux pages de détail :
 * il était posé sur les 268 pages, y compris `/tags/`, `/search/` et la 404,
 * qui ne sont pas des articles.
 */
export type SchemaType =
  "BlogPosting" | "Blog" | "CollectionPage" | "ProfilePage" | "WebPage";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  schemaType?: SchemaType;
  /** Nom de la page dans le JSON-LD, sans le suffixe de marque du `<title>`. */
  schemaName?: string;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  schemaType = "WebPage",
  schemaName,
} = Astro.props;

// `/posts/1/` rend exactement la même page que `/posts/`. Les deux existaient
// en se déclarant chacune canonique d'elle-même : on renvoie la variante `/1/`
// vers la page de base plutôt que de demander à Google de trancher.
const canonicalPath = Astro.url.pathname.replace(/\/1\/$/, "/");
const canonical = canonicalURL ?? new URL(canonicalPath, Astro.site).href;

const socialImageURL = new URL(
  ogImage || SITE.ogImage || "og.png",
  Astro.url.origin
).href;

const isArticle = schemaType === "BlogPosting";

const structuredData = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: schemaName ?? title,
  description,
  url: canonical,
  image: socialImageURL,
  ...(isArticle && {
    headline: schemaName ?? title,
    datePublished: pubDatetime?.toISOString(),
    ...(modDatetime && { dateModified: modDatetime.toISOString() }),
    author: [{ "@type": "Person", name: author, url: profile }],
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  }),
  publisher: {
    "@type": "Organization",
    name: SITE.titleShort,
    url: SITE.website,
  },
};
---

<!doctype html>
<html
  lang=`${LOCALE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="56kode - Blog RSS Feed"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="56kode - AI Radar RSS Feed"
      href="/rss-ai-radar.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:type" content={pubDatetime ? "article" : "website"} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.titleShort} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Polices servies depuis notre origine, fichiers versionnés dans
         src/assets/fonts/. Plus aucune requête vers un tiers : ni preconnect,
         ni chargement différé à contourner, et l'IP du visiteur ne part nulle
         part. IBM Plex Mono porte le chrome, IBM Plex Sans la lecture.

         Pas de `preload` : le provider local ne renseigne pas le sous-ensemble
         dans les données de préchargement, donc `preload` prendrait les 12
         fichiers au lieu des 5 dont la page a besoin — `unicode-range` ne
         filtre pas un préchargement. Le @font-face étant en ligne dans le
         head, sur une connexion same-origin déjà ouverte, les polices sont
         de toute façon reçues avant le premier rendu (mesuré : 40 ms contre
         64 ms de FCP). -->
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-plex-sans" />

    <!-- Site dark-only : valeur figée. C'est la seule couleur littérale hors
         tokens.css, le HTML ne pouvant pas lire une variable CSS. -->
    <meta name="theme-color" content="#070a09" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
