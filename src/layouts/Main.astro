---
import StatusBar from "@components/StatusBar.astro";

interface BaseProps {
  pageDesc?: string;
  rss?: string;
  tone?: "site" | "ai";
  /** Info alignée à droite du titre, ex. « 28 ARTICLES · SORTED BY DATE ». */
  headingMeta?: string;
  /** Zones de la barre de statut. `statusRight` tombe sur le libellé RSS par défaut. */
  statusLeft?: string;
  statusCenter?: string;
  statusRight?: string;
  /** Cible du lien de droite. Par défaut celle de `rss`. */
  statusRightHref?: string;
  indicator?: "signal" | "pulse" | "dead" | "none";
}

interface StringTitleProp extends BaseProps {
  pageTitle: string;
}

interface ArrayTitleProp extends BaseProps {
  pageTitle: [string, string];
  titleTransition: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
const {
  pageDesc,
  rss,
  tone = "site",
  headingMeta,
  statusLeft,
  statusCenter,
  statusRight,
  statusRightHref,
  indicator = tone === "ai" ? "pulse" : "signal",
} = props;

const rightHref = statusRightHref ?? rss;
// Un flux est un document XML nu : ni header, ni footer, aucun retour vers le
// site. C'est le seul cas où ouvrir un onglet rend service plutôt que de
// décider à la place de l'utilisateur.
const rightIsFeed = Boolean(rightHref?.endsWith(".xml"));

const isAi = tone === "ai";
const rssLabel = statusRight ?? (isAi ? "Radar RSS ↗" : "RSS always open ↗");
---

<StatusBar variant={tone} indicator={indicator}>
  <Fragment slot="left">{statusLeft}</Fragment>
  <Fragment slot="center">{statusCenter}</Fragment>
  <Fragment slot="right">
    {
      rightHref ? (
        <a
          href={rightHref}
          target={rightIsFeed ? "_blank" : undefined}
          rel={rightIsFeed ? "noopener" : undefined}
          class="focus-outline uppercase hover:underline"
        >
          {rssLabel}
          {rightIsFeed && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      ) : (
        <span class="uppercase">{rssLabel}</span>
      )
    }
  </Fragment>
</StatusBar>

<main id="main-content" class="w-full">
  <div
    class:list={[
      "max-w-page mx-auto border-b px-(--page-gutter) pt-8 pb-6",
      isAi ? "border-line-ai" : "border-line",
    ]}
  >
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      {
        "titleTransition" in props ? (
          <h1
            class:list={[
              "font-reading text-title font-semibold",
              isAi ? "text-ai-fg" : "text-fg-strong",
            ]}
          >
            {props.pageTitle[0]}{" "}
            <span transition:name={props.titleTransition}>
              {props.pageTitle[1]}
            </span>
          </h1>
        ) : (
          <h1
            class:list={[
              "font-reading text-title font-semibold",
              isAi ? "text-ai-fg" : "text-fg-strong",
            ]}
          >
            {props.pageTitle}
          </h1>
        )
      }
      {
        headingMeta && (
          <p
            class:list={[
              "font-chrome text-meta tracking-chrome uppercase",
              isAi ? "text-ai-muted" : "text-fg-muted",
            ]}
          >
            {headingMeta}
          </p>
        )
      }
    </div>
    {
      pageDesc && (
        <p
          class:list={[
            "max-w-measure font-reading text-lead mt-3 text-pretty",
            isAi ? "text-ai-body" : "text-fg-body",
          ]}
        >
          {pageDesc}
        </p>
      )
    }
  </div>

  <div class="max-w-page mx-auto"><slot /></div>
</main>
