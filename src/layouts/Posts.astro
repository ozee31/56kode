---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import getSiteStats from "@utils/getSiteStats";
import getMinutesRead from "@utils/getMinutesRead";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts }: Props = Astro.props;
const stats = await getSiteStats();
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main
    pageTitle="Posts"
    pageDesc="Everything I have written, oldest habits and newest experiments alike. Frontend architecture, testing, and what actually changes when a model sits in the loop."
    rss="/rss.xml"
    headingMeta={`${stats.posts} articles · sorted by date`}
    statusLeft="Connected · 56.6 kbps · ping 340 ms"
    statusCenter={`${stats.posts} posts · ${totalPages} pages`}
  >
    <ul>
      {
        paginatedPosts.map(post => (
          <Card
            href={`/posts/${post.id}/`}
            frontmatter={post.data}
            readingTime={getMinutesRead(post)}
            action="Read →"
          />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/posts/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
