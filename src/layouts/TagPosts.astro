---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import getHostname from "@utils/getHostname";
import getMinutesRead from "@utils/getMinutesRead";
import getPaginationMeta from "@utils/getPaginationMeta";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
  aiRadarPagination: {
    currentPage: number;
    totalPages: number;
    paginatedPosts: CollectionEntry<"aiRadar">[];
  };
}

const {
  currentPage,
  totalPages,
  paginatedPosts,
  tag,
  tagName,
  aiRadarPagination,
}: Props = Astro.props;

const matches = paginatedPosts.length + aiRadarPagination.paginatedPosts.length;
const { titleSuffix, descSuffix } = getPaginationMeta(currentPage, totalPages);
---

<Layout
  title={`Tag: ${tagName}${titleSuffix} | ${SITE.titleShort}`}
  description={`Every article and AI Radar entry tagged “${tagName}”.${descSuffix}`}
  schemaType="CollectionPage"
  schemaName={`Tag: ${tagName}${titleSuffix}`}
>
  <Header activeNav="tags" />
  <Main
    pageTitle={["Tag:", tagName]}
    titleTransition={tag}
    pageDesc={`Everything tagged “${tagName}” — my own articles first, then the AI Radar entries that carry the same tag.`}
    headingMeta={`Filter active · ${matches} ${matches === 1 ? "match" : "matches"}`}
    statusLeft="Filter active"
    statusCenter={`Tag “${tagName}”`}
    statusRight="All tags →"
    statusRightHref="/tags/"
  >
    {
      paginatedPosts.length > 0 && (
        <section aria-labelledby="tag-posts-label">
          <div class="border-line bg-raised border-b px-(--page-gutter) py-3.5">
            <h2
              id="tag-posts-label"
              class="font-chrome text-meta tracking-chrome-loose text-fg-muted uppercase"
            >
              My posts
            </h2>
          </div>
          <ul>
            {paginatedPosts.map(post => (
              <Card
                href={`/posts/${post.id}/`}
                frontmatter={post.data}
                readingTime={getMinutesRead(post)}
                action="Read →"
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      aiRadarPagination.paginatedPosts.length > 0 && (
        <section aria-labelledby="tag-radar-label" class="bg-ai-canvas">
          <div class="border-line-ai bg-ai-raised border-y px-(--page-gutter) py-3.5">
            <h2
              id="tag-radar-label"
              class="font-chrome text-meta tracking-chrome-loose text-ai-accent uppercase"
            >
              AI Radar
            </h2>
          </div>
          <ul>
            {aiRadarPagination.paginatedPosts.map(item => (
              <Card
                href={`/ai-radar/${item.data.slug}/`}
                frontmatter={item.data}
                tone="ai"
                source={getHostname(item.data.url)}
                action="Read note →"
              />
            ))}
          </ul>
        </section>
      )
    }
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`}
    nextUrl={`/tags/${tag}/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
