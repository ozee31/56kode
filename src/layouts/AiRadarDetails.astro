---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import StatusBar from "@components/StatusBar.astro";
import ArticleBehaviors from "@components/ArticleBehaviors.astro";
import SignalBars from "@components/SignalBars";
import SignalRating from "@components/SignalRating.astro";
import Tags from "@components/Tags";
import Datetime from "@components/Datetime";
import ShareLinks from "@components/ShareLinks.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getHostname from "@utils/getHostname";
import { slugifyStr } from "@utils/slugify";
import { SIGNAL_SCALE } from "@utils/signalScale";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"aiRadar">;
}

const { post }: Props = Astro.props;
const { title, author, description, url, pubDatetime, tags, rating } =
  post.data;

// Le markdown des entrées radar ouvre sur un h1 qui doublonnerait le masthead.
const renderedHTML = post.rendered?.html?.replace(/<h1[^>]*>.*?<\/h1>/gs, "");
const source = getHostname(url);

const sorted = getSortedPosts(
  await getCollection("aiRadar")
) as CollectionEntry<"aiRadar">[];
const index = sorted.findIndex(entry => entry.id === post.id);
const earlier =
  index >= 0 && index < sorted.length - 1 ? sorted[index + 1] : undefined;
const later = index > 0 ? sorted[index - 1] : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author: author ?? "Unknown",
  description,
  pubDatetime,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header activeNav="ai-radar" />

  <div class="bg-ai-canvas flex flex-1 flex-col">
    <StatusBar variant="ai" indicator="pulse">
      <Fragment slot="left">
        <a href="/ai-radar/" class="focus-outline uppercase hover:underline"
          >← All radar entries</a
        >
      </Fragment>
      <Fragment slot="center">
        {index >= 0 && `Entry ${index + 1} of ${sorted.length}`}
      </Fragment>
      <Fragment slot="right">
        <a
          href="/rss-ai-radar.xml"
          target="_blank"
          rel="noopener"
          class="focus-outline uppercase hover:underline"
        >
          Radar RSS ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </Fragment>
    </StatusBar>

    <main id="main-content" class="w-full">
      <!-- Masthead : la source est la destination, pas cette page -->
      <div
        class="border-line-ai from-ai-raised to-ai-canvas border-b bg-gradient-to-b"
      >
        <div
          class="max-w-page mx-auto grid gap-8 px-(--page-gutter) pt-10 pb-9 lg:grid-cols-[1fr_260px]"
        >
          <div>
            <p class="mb-3.5 flex flex-wrap items-center gap-2">
              <Datetime pubDatetime={pubDatetime} tone="ai" />
              {
                source && (
                  <span class="font-chrome text-meta tracking-chrome text-ai-muted uppercase">
                    · {source}
                  </span>
                )
              }
              {
                author && author !== "Unknown" && (
                  <span class="font-chrome text-meta tracking-chrome text-ai-muted">
                    · {author}
                  </span>
                )
              }
            </p>
            <h1
              transition:name={slugifyStr(title)}
              class="font-reading text-display text-ai-fg mb-4 max-w-[24ch] font-semibold text-pretty"
            >
              {title}
            </h1>
            <p
              class="max-w-measure font-reading text-lead text-ai-body mb-6 text-pretty"
            >
              {description}
            </p>
            <a
              href={url}
              class="focus-outline bg-ai-accent font-chrome text-ui tracking-ui text-ai-canvas hover:bg-ai-accent-strong inline-flex items-center gap-2.5 px-5 py-3.5 uppercase transition-colors"
            >
              Read the original{source && ` on ${source}`} ↗
            </a>
          </div>

          {
            /* En mobile, ce bloc allongeait le masthead au point de repousser le
              résumé hors du premier écran. Il repasse sous le résumé, là où il
              sert de verdict après lecture. */
          }
          <div
            class="hidden flex-col justify-between gap-6 lg:flex lg:items-end"
          >
            <SignalRating rating={rating} class="lg:text-right" />
            <p
              class="font-chrome text-micro tracking-ui text-ai-muted leading-[1.8] uppercase lg:text-right"
            >
              Caught <Datetime pubDatetime={pubDatetime} tone="ai" /><br />
              Noted by {SITE.titleShort}
            </p>
          </div>
        </div>
      </div>

      <div class="max-w-page mx-auto grid lg:grid-cols-[1fr_260px]">
        <!-- Ma note sur l'article de quelqu'un d'autre -->
        <div
          class="border-line-ai min-w-0 px-(--page-gutter) pt-10 pb-11 lg:border-r"
        >
          <p
            class="border-line-ai font-chrome text-micro tracking-chrome-wide text-ai-muted mb-4.5 border-b pb-3 uppercase"
          >
            What the article covers
          </p>

          <article id="article" class="prose max-w-measure">
            <div set:html={renderedHTML} />
          </article>

          <Tags tags={tags.map(tag => slugifyStr(tag))} className="mt-9" />

          <!-- La note en mobile, puis le lien sortant : arrivé au bas du
               résumé, le lecteur doit pouvoir juger et partir vers la source
               sans remonter. -->
          <SignalRating
            rating={rating}
            layout="inline"
            class="max-w-measure border-line-ai mt-9 border-t pt-5 lg:hidden"
          />

          <div
            class="max-w-measure lg:border-line-ai mt-6 lg:mt-9 lg:border-t lg:pt-5"
          >
            <a
              href={url}
              class="focus-outline border-ai-accent text-ai-accent hover:bg-ai-accent hover:text-ai-canvas font-chrome text-ui tracking-ui inline-flex items-center gap-2.5 border px-5 py-3.5 uppercase transition-colors"
            >
              Read the original{source && ` on ${source}`} ↗
            </a>
          </div>

          <div
            class="max-w-measure mt-6 flex flex-col-reverse items-start justify-between gap-5 sm:flex-row sm:items-center"
          >
            <button
              id="back-to-top"
              class="focus-outline font-chrome text-meta tracking-chrome text-ai-body hover:text-ai-accent uppercase"
            >
              ↑ Back to top
            </button>
            <ShareLinks {title} {description} />
          </div>
        </div>

        <!-- Rail : tout vient du front-matter -->
        <aside class="hidden flex-col gap-6 px-5 pt-10 pb-11 lg:flex">
          <div>
            <p
              class="font-chrome text-micro tracking-chrome-wide text-ai-muted mb-3 uppercase"
            >
              The source
            </p>
            <div class="border-line-ai bg-ai-raised border p-4">
              <p
                class="font-chrome text-meta tracking-ui text-ai-accent mb-2.5 uppercase"
              >
                {source}
              </p>
              <p class="font-reading text-note text-ai-fg mb-1">
                {
                  author && author !== "Unknown" ? (
                    author
                  ) : (
                    <span class="text-ai-muted">Author not credited</span>
                  )
                }
              </p>
              <p class="mb-3.5">
                <Datetime pubDatetime={pubDatetime} tone="ai" />
              </p>
              <a
                href={url}
                class="focus-outline font-chrome text-meta tracking-ui text-ai-accent uppercase hover:underline"
              >
                Open original ↗
              </a>
            </div>
          </div>

          <div class="border-line-ai border-t pt-5">
            <p
              class="font-chrome text-micro tracking-chrome-wide text-ai-muted mb-3 uppercase"
            >
              How I rate
            </p>
            <ul class="flex flex-col gap-2.5">
              {
                SIGNAL_SCALE.map(step => (
                  <li class="flex items-center gap-2.5">
                    <SignalBars value={step.value} variant="ai" size="sm" />
                    <span
                      class:list={[
                        "font-reading text-body-sm",
                        step.value === Math.round(rating)
                          ? "text-ai-fg"
                          : "text-ai-body",
                      ]}
                    >
                      {step.label}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="border-line-ai border-t pt-5">
            <p
              class="font-chrome text-micro tracking-chrome-wide text-ai-muted mb-2.5 uppercase"
            >
              Radar
            </p>
            <p
              class="font-chrome text-micro tracking-ui text-ai-muted leading-[1.8] uppercase"
            >
              {sorted.length} entries total<br />
              {index >= 0 && `This one is #${index + 1}`}
            </p>
          </div>
        </aside>
      </div>

      <!-- Entrées voisines : grammaire de la liste, note comprise -->
      {
        (earlier || later) && (
          <div class="max-w-page border-line-ai mx-auto grid border-t sm:grid-cols-2">
            {earlier && (
              <a
                href={`/ai-radar/${earlier.data.slug}/`}
                class="focus-outline group border-line-ai block border-b px-(--page-gutter) py-6 sm:border-r sm:border-b-0"
              >
                <p class="font-chrome text-micro tracking-chrome-wide text-ai-muted mb-3 uppercase">
                  ← Earlier catch
                </p>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <Datetime pubDatetime={earlier.data.pubDatetime} tone="ai" />
                  <SignalBars
                    value={earlier.data.rating}
                    variant="ai"
                    size="sm"
                  />
                </div>
                <p class="font-reading text-heading text-ai-fg group-hover:decoration-ai-accent max-w-[30ch] font-semibold text-pretty group-hover:underline">
                  {earlier.data.title}
                </p>
              </a>
            )}
            {later && (
              <a
                href={`/ai-radar/${later.data.slug}/`}
                class="focus-outline group block px-(--page-gutter) py-6 sm:text-right"
              >
                <p class="font-chrome text-micro tracking-chrome-wide text-ai-muted mb-3 uppercase">
                  Later catch →
                </p>
                <div class="mb-2 flex items-center justify-between gap-4">
                  <SignalBars
                    value={later.data.rating}
                    variant="ai"
                    size="sm"
                  />
                  <Datetime pubDatetime={later.data.pubDatetime} tone="ai" />
                </div>
                <p class="font-reading text-heading text-ai-fg group-hover:decoration-ai-accent max-w-[30ch] font-semibold text-pretty group-hover:underline sm:ml-auto">
                  {later.data.title}
                </p>
              </a>
            )}
          </div>
        )
      }
    </main>
  </div>

  <Footer />
  <ArticleBehaviors />
</Layout>
