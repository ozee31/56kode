---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "./Layout.astro";
import Main from "./Main.astro";
import Pagination from "@components/Pagination.astro";
import type { CollectionEntry } from "astro:content";
import Card from "@components/Card";
import getSiteStats from "@utils/getSiteStats";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"techwatch">[];
}

const { currentPage, totalPages, paginatedPosts }: Props = Astro.props;
const stats = await getSiteStats();
---

<Layout
  title="Tech Watch: Curated Articles on AI, Frontend & Development"
  description="Curated articles on AI, frontend development, React, TypeScript, and developer tools. Stay ahead with the latest trends and insights."
>
  <Header activeNav="tech-watch" />
  <Main
    pageTitle="Tech watch archive"
    pageDesc="Link dumps kept online so old URLs keep resolving. No summaries, no ratings, no upkeep — the AI Radar replaced this format."
    rss="/rss-techwatch.xml"
    headingMeta={`${stats.techwatch} entries · frozen`}
    indicator="none"
    statusLeft="Archived · not in navigation · no longer updated"
    statusCenter={`${stats.techwatch} entries · ${totalPages} pages`}
  >
    <p class="px-(--page-gutter) pt-6">
      <a
        href="/ai-radar/"
        class="focus-outline font-chrome text-ui tracking-ui text-ai-accent uppercase hover:underline"
      >
        Go to AI Radar →
      </a>
    </p>
    <ul>
      {
        paginatedPosts.map(item => (
          <Card
            href={item.data.url}
            frontmatter={{
              author: item.data.author || "Unknown",
              title: item.data.title,
              pubDatetime: item.data.pubDatetime,
              modDatetime: item.data.pubDatetime,
              description: item.data.description,
              tags: item.data.tags,
            }}
            displayAuthor
            action="Source ↗"
          />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tech-watch${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/tech-watch/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
