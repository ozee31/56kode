---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import StatusBar from "@components/StatusBar.astro";
import ArticleBehaviors from "@components/ArticleBehaviors.astro";
import Tags from "@components/Tags";
import Datetime from "@components/Datetime";
import ShareLinks from "@components/ShareLinks.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { slugifyStr } from "@utils/slugify";
import getMinutesRead from "@utils/getMinutesRead";
import extractHeadings from "@utils/extractHeadings";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post }: Props = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const renderedHTML = post.rendered?.html;
const readingTime = getMinutesRead(post);
const headings = extractHeadings(renderedHTML);

// Position dans la série et voisins immédiats, pour la barre de statut et le
// bloc prev/next. Une seule lecture de la collection sert les deux.
const sorted = getSortedPosts(
  await getCollection("blog")
) as CollectionEntry<"blog">[];
const index = sorted.findIndex(entry => entry.id === post.id);
const previous = index > 0 ? sorted[index - 1] : undefined;
const next =
  index >= 0 && index < sorted.length - 1 ? sorted[index + 1] : undefined;

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header activeNav="posts" />

  <StatusBar>
    <Fragment slot="left">
      <a href="/posts/" class="focus-outline uppercase hover:underline"
        >← All posts</a
      >
    </Fragment>
    <Fragment slot="center">
      {index >= 0 && `Article ${index + 1} of ${sorted.length}`}
    </Fragment>
    <Fragment slot="right">
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener"
        class="focus-outline uppercase hover:underline"
      >
        RSS always open ↗<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </Fragment>
  </StatusBar>

  <main id="main-content" class="w-full">
    <!-- Masthead : la carte de liste, promue -->
    <div class="border-line from-feature to-canvas border-b bg-gradient-to-b">
      <div
        class="max-w-page mx-auto grid gap-8 px-(--page-gutter) pt-10 pb-9 sm:grid-cols-[1fr_132px]"
      >
        <div>
          <Datetime
            pubDatetime={pubDatetime}
            modDatetime={modDatetime}
            className="mb-3.5 block"
          />
          <h1
            transition:name={slugifyStr(title)}
            class="font-reading text-display text-fg-strong mb-4 max-w-[24ch] font-semibold text-pretty"
          >
            {title}
          </h1>
          <p
            class="max-w-measure font-reading text-lead text-fg-body text-pretty"
          >
            {description}
          </p>
        </div>
        <div
          class="flex flex-row items-center justify-between gap-2 sm:flex-col sm:items-end"
        >
          <p
            class="font-chrome text-meta tracking-chrome text-fg-muted uppercase"
          >
            {readingTime}
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-page mx-auto grid lg:grid-cols-[1fr_260px]">
      <!-- Colonne de lecture -->
      <div
        class="border-line min-w-0 px-(--page-gutter) pt-10 pb-11 lg:border-r"
      >
        <article id="article" class="prose max-w-measure">
          <div set:html={renderedHTML} />
        </article>

        <Tags tags={tags.map(tag => slugifyStr(tag))} className="mt-9" />

        <div
          class="max-w-measure border-line mt-9 flex flex-col-reverse items-start justify-between gap-5 border-t pt-5 sm:flex-row sm:items-center"
        >
          <button
            id="back-to-top"
            class="focus-outline font-chrome text-meta tracking-chrome text-fg-secondary hover:text-accent uppercase"
          >
            ↑ Back to top
          </button>
          <ShareLinks {title} {description} />
        </div>
      </div>

      <!-- Rail : sommaire construit depuis les titres du markdown -->
      <aside class="hidden flex-col gap-6 px-5 pt-10 pb-11 lg:flex">
        {
          headings.length > 0 && (
            <nav aria-labelledby="toc-label">
              <p
                id="toc-label"
                class="font-chrome text-micro tracking-chrome-wide text-fg-muted mb-3 uppercase"
              >
                On this page
              </p>
              <ul class="flex flex-col gap-2.5">
                {headings.map(heading => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        "focus-outline font-reading text-note text-fg-secondary hover:text-accent block leading-snug",
                        heading.depth > 2 && "border-line border-l pl-3.5",
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <div class="border-line border-t pt-5">
          <p
            class="font-chrome text-micro tracking-chrome-wide text-fg-muted mb-2.5 uppercase"
          >
            Carrier
          </p>
          <p
            class="font-chrome text-micro tracking-ui text-fg-muted leading-[1.8] uppercase"
          >
            Published <Datetime pubDatetime={pubDatetime} hasVisibleLabel /><br
            />
            Read time {readingTime}<br />
            56.6 kbps
          </p>
        </div>
      </aside>
    </div>

    <!-- Prev / next : même grammaire de carte que la liste -->
    {
      (previous || next) && (
        <div class="max-w-page border-line mx-auto grid border-t sm:grid-cols-2">
          {previous && (
            <a
              href={`/posts/${previous.id}/`}
              class="focus-outline group border-line block border-b px-(--page-gutter) py-6 sm:border-r sm:border-b-0"
            >
              <p class="font-chrome text-micro tracking-chrome-wide text-fg-muted mb-2.5 uppercase">
                ← Previous
              </p>
              <p class="font-reading text-heading text-fg-heading group-hover:decoration-accent mb-2 max-w-[30ch] font-semibold text-pretty group-hover:underline">
                {previous.data.title}
              </p>
              <Datetime
                pubDatetime={previous.data.pubDatetime}
                modDatetime={previous.data.modDatetime}
              />
            </a>
          )}
          {next && (
            <a
              href={`/posts/${next.id}/`}
              class="focus-outline group block px-(--page-gutter) py-6 sm:text-right"
            >
              <p class="font-chrome text-micro tracking-chrome-wide text-fg-muted mb-2.5 uppercase">
                Next →
              </p>
              <p class="font-reading text-heading text-fg-heading group-hover:decoration-accent mb-2 max-w-[30ch] font-semibold text-pretty group-hover:underline sm:ml-auto">
                {next.data.title}
              </p>
              <Datetime
                pubDatetime={next.data.pubDatetime}
                modDatetime={next.data.modDatetime}
              />
            </a>
          )}
        </div>
      )
    }
  </main>

  <Footer />
  <ArticleBehaviors />
</Layout>
