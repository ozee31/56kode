---
import LinkButton from "./LinkButton.astro";
import socialIcons from "@assets/socialIcons";

export interface Props {
  title: string;
  description?: string;
}

const { title, description }: Props = Astro.props;

const url = Astro.url.href;
const enc = encodeURIComponent;

/**
 * Coupe sur une frontière de mot et suffixe une ellipse.
 * X et Bluesky ont des limites dures : un texte tronqué au milieu d'un mot,
 * ou un partage refusé, sont deux mauvaises façons d'échouer.
 */
function truncate(text: string, max: number): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  const boundary = cut.lastIndexOf(" ");
  return `${(boundary > max * 0.6 ? cut.slice(0, boundary) : cut).trimEnd()}…`;
}

const blurb = description?.trim() || title;

// X : 280 caractères, l'URL en consomme 23 quelle que soit sa longueur (t.co).
const xText = truncate(blurb, 230);
// Bluesky : un seul champ de 300 caractères, URL comprise et non raccourcie.
const blueskyText = `${truncate(blurb, Math.max(40, 292 - url.length))}\n\n${url}`;

/**
 * Réseaux où un article de dev a une chance d'être partagé. WhatsApp, Telegram
 * et Pinterest ont été retirés : héritage du thème AstroPaper, sans usage ici.
 *
 * LinkedIn et Facebook n'acceptent **que** l'URL : leurs paramètres de texte
 * (`title`/`summary` pour l'ancien `shareArticle`, `quote` pour Facebook) sont
 * dépréciés et ignorés. Les deux construisent leur aperçu à partir des balises
 * Open Graph de la page — c'est donc `Layout.astro` qui décide de leur rendu,
 * pas ce composant.
 */
const shareLinks = [
  {
    name: "X",
    href: `https://x.com/intent/post?text=${enc(xText)}&url=${enc(url)}`,
    linkTitle: "Share this post on X",
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
    linkTitle: "Share this post on LinkedIn",
  },
  {
    name: "Bluesky",
    href: `https://bsky.app/intent/compose?text=${enc(blueskyText)}`,
    linkTitle: "Share this post on Bluesky",
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer.php?u=${enc(url)}`,
    linkTitle: "Share this post on Facebook",
  },
  {
    name: "Mail",
    href: `mailto:?subject=${enc(title)}&body=${enc(`${blurb}\n\n${url}`)}`,
    linkTitle: "Share this post via email",
  },
] as const;
---

<div class={`social-icons`}>
  <span
    class="font-chrome text-micro tracking-chrome-wide text-fg-muted uppercase"
    >Share this post on</span
  >
  <div class="text-center">
    {
      shareLinks.map(social => (
        <LinkButton
          href={social.href}
          class="link-button"
          title={social.linkTitle}
        >
          <Fragment set:html={socialIcons[social.name]} />
          <span class="sr-only">{social.linkTitle}</span>
        </LinkButton>
      ))
    }
  </div>
</div>

<style>
  @reference "../styles/theme.css";
  .social-icons {
    @apply flex flex-col flex-wrap items-center justify-center gap-2;
  }
  .link-button {
    @apply scale-90 p-2;
  }

  @media (width >= 640px) {
    .social-icons {
      @apply items-start;
    }
    .link-button {
      @apply p-1;
    }
  }
</style>
