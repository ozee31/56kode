---
import { LOGO_IMAGE, SITE } from "@config";
import getYearsOfExperience from "@utils/getYearsOfExperience";

export interface Props {
  activeNav?: "posts" | "tags" | "about" | "search" | "ai-radar" | "tech-watch";
}

const { activeNav } = Astro.props;
const years = getYearsOfExperience();

// L'AI Radar porte toujours l'accent AI, actif ou non : c'est la règle du
// design system (« everything AI » utilise --color-accent-ai).
const NAV = [
  { href: "/posts/", label: "Posts", key: "posts", ai: false },
  { href: "/ai-radar/", label: "AI Radar", key: "ai-radar", ai: true },
  { href: "/tags/", label: "Tags", key: "tags", ai: false },
  { href: "/about/", label: "About", key: "about", ai: false },
] as const;
---

<header class="border-line bg-canvas relative z-50 border-b">
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div id="menu-scrim" class="menu-scrim" aria-hidden="true"></div>
  <div
    class="max-w-page mx-auto flex items-center justify-between gap-6 px-(--page-gutter) py-3"
  >
    <a
      href="/"
      class="focus-outline flex items-baseline gap-3 whitespace-nowrap"
    >
      {
        LOGO_IMAGE.enable ? (
          <img
            src={`/assets/${LOGO_IMAGE.svg ? "logo.svg" : "logo.png"}`}
            alt={SITE.title}
            width={LOGO_IMAGE.width}
            height={LOGO_IMAGE.height}
          />
        ) : (
          <span class="font-chrome text-logo text-accent font-semibold">
            {SITE.titleShort}
          </span>
        )
      }
      <span
        class="font-chrome text-meta tracking-chrome text-fg-muted hidden sm:inline"
      >
        {years} years of uptime
      </span>
    </a>

    <nav id="nav-menu" class="flex items-center" aria-label="Main">
      <button
        class="hamburger-menu focus-outline"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="menu-icon"
        >
          <line x1="7" y1="12" x2="21" y2="12" class="line"></line>
          <line x1="3" y1="6" x2="21" y2="6" class="line"></line>
          <line x1="12" y1="18" x2="21" y2="18" class="line"></line>
          <line x1="18" y1="6" x2="6" y2="18" class="close"></line>
          <line x1="6" y1="6" x2="18" y2="18" class="close"></line>
        </svg>
      </button>

      <ul id="menu-items">
        {
          NAV.map(item => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "focus-outline nav-link",
                  item.ai ? "nav-link-ai text-ai-accent" : "text-fg-secondary",
                  activeNav === item.key && (item.ai ? "active-ai" : "active"),
                ]}
                aria-current={activeNav === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/search/"
            class:list={[
              "focus-outline search-field",
              activeNav === "search" && "border-accent text-accent",
            ]}
            aria-label="Search"
            title="Search"
            aria-current={activeNav === "search" ? "page" : undefined}
          >
            <span aria-hidden="true">/</span>
            <span>search</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  @reference "../styles/theme.css";

  #skip-to-content {
    @apply bg-accent font-chrome text-ui text-on-accent absolute -top-full left-16 z-50 px-3 py-2 transition-all focus:top-4;
  }

  .hamburger-menu {
    @apply border-line-strong grid size-11 place-items-center border;
  }
  .hamburger-menu svg {
    @apply stroke-fg-secondary size-5 fill-none;
  }
  .menu-icon line {
    @apply transition-opacity duration-75 ease-in-out;
  }
  .menu-icon .close {
    opacity: 0;
  }
  .menu-icon.is-active .line {
    @apply opacity-0;
  }
  .menu-icon.is-active .close {
    @apply opacity-100;
  }

  /* Voile d'assombrissement du reste de la page quand le menu est ouvert.
     Pas de flou : ce serait le seul effet de ce genre du système, et le design
     tient sur des aplats et des filets. Assombrir suffit à faire du panneau un
     calque, puisque bg-raised et bg-canvas ne sont séparés que de quelques
     valeurs. */
  .menu-scrim {
    @apply fixed inset-0 hidden bg-black/70;
  }

  /* Le panneau est `absolute` (ancré au document) et le voile `fixed` (ancré au
     viewport) : les laisser défiler les désolidarise, le panneau sort de l'écran
     et le voile reste seul à couvrir la page, qui devient noire et inerte. On
     gèle donc le défilement le temps de l'ouverture. Le verrou est posé sur
     <html> et non sur <body> : c'est le seul des deux que Safari iOS respecte. */
  :global(html.menu-open) {
    @apply overflow-hidden;
  }
  .menu-scrim.open {
    @apply block;
  }

  /* Mobile : le menu se replie derrière le bouton 44px. */
  #menu-items {
    @apply border-line-strong bg-raised absolute inset-x-0 top-full hidden flex-col border-b px-(--page-gutter) py-2;
  }
  #menu-items.open {
    @apply flex;
  }
  #menu-items li a {
    @apply font-chrome text-ui tracking-ui flex min-h-11 items-center uppercase;
  }

  /* Le survol amène un lien à son propre accent. Un lien déjà à son accent ne
     bouge donc pas : le lien actif, et le lien AI Radar, qui porte l'accent AI
     en permanence par choix du design system. D'où l'exclusion plutôt qu'une
     teinte de survol dédiée — inventer un bleu de survol donnerait au seul
     lien AI un état que les autres n'ont pas. */
  .nav-link:not(.nav-link-ai):hover {
    @apply text-accent;
  }
  .nav-link.active {
    @apply text-accent;
  }

  .search-field {
    @apply border-line-strong font-chrome text-ui text-fg-muted flex items-center gap-2 border px-2.5 tracking-normal lowercase;
  }
  .search-field:hover {
    @apply border-accent text-accent;
  }

  @media (width >= 640px) {
    .hamburger-menu {
      @apply hidden;
    }
    .menu-scrim,
    .menu-scrim.open {
      @apply hidden;
    }
    #menu-items {
      @apply static flex flex-row items-center gap-6 border-0 bg-transparent p-0;
    }
    #menu-items li a {
      @apply min-h-0 py-0.5;
    }
    .nav-link.active {
      @apply border-accent border-b-2;
    }
    .nav-link.active-ai {
      @apply border-ai-accent border-b-2;
    }
    .search-field {
      @apply h-(--control-size) pr-6;
    }
  }
</style>

<script>
  function toggleNav() {
    const menuBtn =
      document.querySelector<HTMLButtonElement>(".hamburger-menu");
    const menuIcon = document.querySelector(".menu-icon");
    const menuItems = document.querySelector("#menu-items");
    const scrim = document.querySelector("#menu-scrim");
    const header = menuBtn?.closest("header");
    const desktop = window.matchMedia("(width >= 640px)");

    // Éléments qu'on a nous-mêmes rendus inertes, pour ne rendre au DOM que ce
    // qu'on lui a pris si un jour quelque chose d'autre pose `inert`.
    let inerted: Element[] = [];

    function setOpen(open: boolean) {
      menuIcon?.classList.toggle("is-active", open);
      menuItems?.classList.toggle("open", open);
      scrim?.classList.toggle("open", open);
      menuBtn?.setAttribute("aria-expanded", open ? "true" : "false");
      menuBtn?.setAttribute("aria-label", open ? "Close Menu" : "Open Menu");
      document.documentElement.classList.toggle("menu-open", open);

      // Le voile masque le reste de la page, il ne le neutralise pas : les liens
      // derrière restent tabulables et activables, puisque le clavier ignore
      // `pointer-events`, et un lecteur d'écran ne sait même pas que le menu
      // s'est ouvert. `inert` retire les deux d'un coup.
      if (open) {
        inerted = Array.from(document.body.children).filter(
          child => child !== header && !child.hasAttribute("inert")
        );
        inerted.forEach(child => child.setAttribute("inert", ""));
      } else {
        inerted.forEach(child => child.removeAttribute("inert"));
        inerted = [];
      }
    }

    // Fermer sans rendre le focus le laisserait retomber sur <body> : la
    // tabulation suivante repartirait du lien d'évitement.
    function close() {
      const hadFocus = menuItems?.contains(document.activeElement);
      setOpen(false);
      if (hadFocus || document.activeElement === document.body)
        menuBtn?.focus();
    }

    menuBtn?.addEventListener("click", () => {
      if (menuBtn.getAttribute("aria-expanded") === "true") close();
      else setOpen(true);
    });

    // Cliquer le voile ferme le menu : c'est ce qu'un utilisateur tente en
    // premier, et sans ça le voile est un mur qui n'obéit à rien.
    scrim?.addEventListener("click", close);

    // Échap ferme aussi, pour qui navigue au clavier.
    document.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      if (menuBtn?.getAttribute("aria-expanded") !== "true") return;
      close();
    });

    // Passer en desktop escamote le hamburger : sans ça le verrou de défilement
    // et les `inert` survivraient à un simple pivot d'écran, sans plus aucun
    // bouton pour les lever.
    desktop.addEventListener("change", event => {
      if (event.matches) setOpen(false);
    });

    // Le swap d'une view transition remplace <body> mais pas <html> : on repart
    // d'un état propre plutôt que d'hériter d'un verrou orphelin.
    setOpen(false);
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
