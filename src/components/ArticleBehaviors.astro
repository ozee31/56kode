---
// Comportements de la page d'article, extraits à l'identique de PostDetails.astro
// et AiRadarDetails.astro, qui en portaient chacun une copie (117 et 89 lignes,
// identiques à quelques commentaires près).
//
// Barre de progression de lecture, ancres de titres, boutons « copier » sur les
// blocs de code, retour en haut de page.
//
// Reste `is:inline` : le script manipule le DOM avant hydratation et ne peut
// pas être bundlé sans changer son moment d'exécution.
//
// ⚠️ Les classes Tailwind ci-dessous vivent dans des chaînes JS. Elles sont bien
// scannées par Tailwind, mais elles ne remontent pas dans un grep de markup :
// toute suppression de token doit les vérifier ici aussi.
---

<script is:inline>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-raised";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    const winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    if (document) {
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = scrolled + "%";
      }
    }
  }
  document.addEventListener("scroll", updateScrollProgress);

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    // Portée limitée au contenu rendu : la sélection couvrait tout le document,
    // donc les <h2> de colonne du pied de page (« Elsewhere », « Feeds »)
    // recevaient un lien `href="#"` annoncé « Link to section ».
    const article = document.getElementById("article");
    if (!article) return;
    const headings = Array.from(article.querySelectorAll("h2, h3, h4, h5, h6"));
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ml-2 text-accent opacity-0 group-hover:opacity-100 focus:opacity-100 [@media(hover:none)]:opacity-100";
      link.href = "#" + heading.id;
      link.setAttribute(
        "aria-label",
        "Link to section: " + heading.textContent.trim()
      );

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    codeBlocks.forEach((codeBlock, index) => {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 border border-line-strong bg-raised px-2 py-1 font-chrome text-micro uppercase tracking-chrome leading-4 text-fg-secondary hover:border-accent hover:text-accent";
      copyButton.innerHTML = copyButtonLabel;

      // Le texte visible reste « Copy » ; le nom accessible distingue les
      // boutons, sans quoi un lecteur d'écran en annonce onze identiques.
      // Le langage vient de Shiki, qui le pose sur le <pre>.
      const language = codeBlock.getAttribute("data-language");
      copyButton.setAttribute(
        "aria-label",
        language
          ? `Copy ${language} code block ${index + 1}`
          : `Copy code block ${index + 1}`
      );
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    });

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /** Scrolls the document to the top when
   * the "Back to Top" button is clicked. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
  backToTop();
</script>
