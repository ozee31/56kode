---
// Pagination partagée par les 4 layouts de liste (posts, ai-radar, tags,
// tech-watch). Un seul markup, deux jeux d'accent : sur le canvas AI la
// géométrie ne change pas, seules les couleurs basculent.
//
// Écart assumé vis-à-vis des maquettes : elles montrent des cellules numérotées
// (1 2 3 4 5). Les générer supposerait de construire des URLs de page ici,
// alors que chaque layout appelant fabrique déjà les siennes — le plan interdit
// de toucher à ces chaînes. On garde donc la forme PREV / PAGE n OF m / NEXT,
// qui est celle que les maquettes elles-mêmes utilisent en mobile, avec le
// traitement visuel (cellules carrées, filets, aplat) du design system.
export interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl: string;
  nextUrl: string;
  variant?: "site" | "ai";
}

const {
  currentPage,
  totalPages,
  prevUrl,
  nextUrl,
  variant = "site",
}: Props = Astro.props;

const isPrevDisabled = currentPage <= 1;
const isNextDisabled = currentPage >= totalPages;
const isAi = variant === "ai";

const cell = [
  "flex h-(--control-size) items-center justify-center border px-3.5",
  "font-chrome text-ui uppercase tracking-ui transition-colors",
];
const idle = isAi
  ? "border-line-ai text-ai-body hover:border-ai-accent hover:text-ai-accent"
  : "border-line-strong text-fg-secondary hover:border-accent hover:text-accent";
const off = isAi
  ? "pointer-events-none border-line-ai/60 text-ai-muted/50"
  : "pointer-events-none border-line-subtle text-fg-muted/50";
---

{
  totalPages > 1 && (
    <nav
      class="mt-auto mb-10 flex items-center justify-center gap-2 pt-4"
      aria-label="Pagination"
    >
      <a
        href={isPrevDisabled ? undefined : prevUrl}
        aria-disabled={isPrevDisabled}
        class:list={["focus-outline", cell, isPrevDisabled ? off : idle]}
      >
        ← Prev
      </a>

      <span
        class:list={[
          "font-chrome text-meta tracking-chrome flex h-(--control-size) items-center px-3.5",
          isAi ? "text-ai-muted" : "text-fg-muted",
        ]}
      >
        Page {currentPage} of {totalPages}
      </span>

      <a
        href={isNextDisabled ? undefined : nextUrl}
        aria-disabled={isNextDisabled}
        class:list={["focus-outline", cell, isNextDisabled ? off : idle]}
      >
        Next →
      </a>
    </nav>
  )
}
