---
import { getCollection } from "astro:content";
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SearchBar from "@components/Search";
import getSortedPosts from "@utils/getSortedPosts";

// Retrieve all published articles
const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

const aiRadarPosts = await getCollection("aiRadar");
const sortedAiRadarPosts = getSortedPosts(aiRadarPosts);

// List of items to search in
const searchList = [
  ...sortedPosts.map(({ data, id }) => ({
    title: data.title,
    description: data.description,
    data,
    href: `/posts/${id}/`,
  })),
  ...sortedAiRadarPosts.map(({ data }) => ({
    title: data.title,
    description: data.description,
    data,
    href: `/ai-radar/${data.slug}/`,
  })),
];
---

<Layout
  title={`Search | ${SITE.titleShort}`}
  description="Search the posts and the AI Radar by title and summary."
  schemaName="Search"
>
  <Header activeNav="search" />
  <Main
    pageTitle="Search"
    pageDesc="Search the posts and the AI Radar. Titles and summaries, matched as you type."
    headingMeta={`${searchList.length} entries indexed`}
    statusLeft="Index loaded · client-side"
    statusCenter={`${sortedPosts.length} posts · ${sortedAiRadarPosts.length} radar entries`}
  >
    <SearchBar client:load searchList={searchList} />
  </Main>
  <Footer />
</Layout>
